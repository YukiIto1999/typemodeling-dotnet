{
  "stryker-config": {
    "project": "src/TypeModeling/TypeModeling.csproj",
    "test-runner": "mtp",
    "ignore-mutations": [
      "string"
    ],
    "test-projects": [
      "tests/TypeModeling.Tests/TypeModeling.Tests.csproj"
    ],
    "mutate": [
      "**/*.cs",
      "!**/obj/**/*.cs"
    ],
    "reporters": [
      "json",
      "progress"
    ],
    "coverage-analysis": "perTest",
    "thresholds": {
      "high": 90,
      "low": 70,
      "break": 60
    }
  }
}
